# Copy this file to .env and edit as needed. Nothing here is required to
# get started -- defaults work for a single-user local self-host.

# Set this if you're exposing the ACE-Step API beyond localhost (e.g. on a
# LAN or the internet). Leave blank for local-only use.
ACESTEP_API_KEY=

# auto | true | false -- whether to load the language-model component.
# "auto" picks based on detected VRAM. Set "false" to force lightweight
# DiT-only mode on low-VRAM or CPU-only machines.
ACESTEP_INIT_LLM=auto

# auto | huggingface | modelscope -- where model weights download from.
# Use "modelscope" if HuggingFace is unreachable/blocked from your network.
ACESTEP_DOWNLOAD_SOURCE=auto

# htdemucs (v4, default, best general quality) | htdemucs_ft (fine-tuned,
# slower, higher quality) | mdx_extra_q (fastest, CPU-friendly)
DEMUCS_MODEL=htdemucs

ACE_STEP_PORT=8001
DEMUCS_PORT=8010

# --- Which ACE-Step to build (optional) ---------------------------------
# Upstream is the default and is almost always what you want. Set these only
# to build a fork -- e.g. one you have changed. Weights are NOT in either
# repository; they download on first request regardless of which you build.
# ACE_STEP_REPO=https://github.com/YOUR_USER/ACE-Step-1.5.git
# ACE_STEP_REF=main
